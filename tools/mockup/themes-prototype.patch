+void Wm::paint_title_proto(Canvas &c0, Window &w, const Rect &title, bool active)
+{
+    const Rect &f = w.frame_;
+    c0.layered(title, [&](Canvas &c) {
+    const Rect first = title_button(w, w.dialog_ ? Part::Close : Part::Minimize);
+    const int tw = Canvas::text_width(w.title_, true);
+    if (gfx::theme_id == 1) {
+        // One-bit: white bar, black pinstripes when active, the title in a
+        // gap in the middle, a black line under it.
+        c.fill(title, gfx::kWhite);
+        if (active) {
+            for (int y = title.y + 3; y < title.bottom() - 3; y += 2) {
+                c.hline(title.x + 1, y, title.w - 2, gfx::kBlack);
+            }
+        }
+        c.hline(title.x, title.bottom() - 1, title.w, gfx::kBlack);
+        int tx = title.x + (title.w - tw) / 2;
+        if (tx < f.x + 28) {
+            tx = f.x + 28;
+        }
+        if (w.icon_ != nullptr) {
+            c.fill({f.x + 4, title.y, 19, title.h - 1}, gfx::kWhite);
+            c.blit(*w.icon_, f.x + 5, f.y + 5);
+        }
+        Canvas text = c.sub({title.x, title.y, first.x - 4 - title.x, title.h});
+        text.fill({tx - title.x - 6, 0, tw + 12, title.h - 1}, gfx::kWhite);
+        text.text(tx - title.x, 2, w.title_, active ? gfx::kBlack : gfx::kDarkGrey, true);
+    } else {
+        // Workbench-like: a solid bar in the accent colour when active, a
+        // light line above and a dark one below, black title at the left.
+        c.fill(title, active ? gfx::kAccent : gfx::kGrey);
+        c.hline(title.x, title.y, title.w, gfx::kWhite);
+        c.hline(title.x, title.bottom() - 1, title.w, gfx::kBlack);
+        if (w.icon_ != nullptr) {
+            c.blit(*w.icon_, f.x + 5, f.y + 5);
+        }
+        Canvas text = c.sub({title.x, title.y, first.x - 4 - title.x, title.h});
+        text.text(22, 3, w.title_, gfx::kBlack, active);
+    }
+    for (Part p : {Part::Close, Part::Maximize, Part::Minimize}) {
+        const Rect r = title_button(w, p);
+        if (r.empty()) {
+            continue;
+        }
+        const bool held = capture_ == Capture::TitleButton && captured_ == &w &&
+                          captured_part_ == p && captured_inside_;
+        const gfx::Colour ink = (p == Part::Maximize && !w.resizable_) ? gfx::kDarkGrey : gfx::kBlack;
+        if (gfx::theme_id == 1) {
+            if (!active) {
+                continue; // an inactive window shows no boxes
+            }
+            // A plain box, 13 x 13, with a white gap in the stripes around it.
+            const Rect box = {r.x + 1, title.y + 2, 13, 13};
+            c.fill({box.x - 2, title.y, box.w + 4, title.h - 1}, gfx::kWhite);
+            c.edge(box, gfx::kBlack, gfx::kBlack);
+            if (held) {
+                c.fill(box.inset(1), gfx::kBlack);
+            }
+            const gfx::Colour gi = held ? gfx::kWhite : ink;
+            if (p == Part::Close) {
+                c.pattern(box.x + 3, box.y + 3, kCloseGlyph, 7, gi);
+            } else if (p == Part::Maximize) {
+                c.pattern(box.x + 2, box.y + 2, w.state_ == WindowState::Maximized ? kRestoreGlyph : kMaxGlyph, 9, gi);
+            } else {
+                c.hline(box.x + 3, box.y + 9, 7, gi);
+            }
+            continue;
+        }
+        // Workbench-like: gadgets the full height of the bar.
+        const Rect g = {r.x - 1, title.y, 18, title.h};
+        c.fill(g.inset(1), held ? gfx::kGrey : (active ? gfx::kAccent : gfx::kGrey));
+        c.edge(g, held ? gfx::kBlack : gfx::kWhite, held ? gfx::kWhite : gfx::kBlack);
+        if (p == Part::Close) {
+            c.pattern(g.x + 5, g.y + 5, kWbClose, 7, ink);
+            c.fill({g.x + 7, g.y + 7, 5, 5}, gfx::kWhite);
+            c.edge({g.x + 6, g.y + 6, 7, 7}, ink, ink);
+        } else if (p == Part::Maximize) {
+            c.pattern(g.x + 5, g.y + 4, w.state_ == WindowState::Maximized ? kWbRestore : kWbMax, 9, ink);
+        } else {
+            c.pattern(g.x + 5, g.y + 4, kWbMin, 9, ink);
+        }
+    }
+    });
+}
