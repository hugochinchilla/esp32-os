# ESP32-S3-N16R8: 16 MB quad flash, 8 MB octal PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Recommended by Espressif for RGB output from a PSRAM framebuffer
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Re-align the picture at every vertical blank if the output ever slips
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
# Debug link speed. If the link is unreliable, change this to 115200, delete
# the sdkconfig file, rebuild, and pass --baud 115200 to tools/dbg.py.
# The speed is only taken from here when the console is set to "custom".
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Code and constants run from PSRAM, so writing the flash (C:) does not turn
# the cache off and the video keeps reading its framebuffer (docs/DECISIONS.md).
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
# Wi-Fi: its buffers and the network stack's go to external RAM when they
# can, to keep internal RAM free
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Task list for tools/dbg.py memory (stack high-water marks)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
# Internal RAM (docs/DECISIONS.md, measured 2026-11-16): 8 static Wi-Fi
# receive buffers instead of 16, and the Wi-Fi code not kept in internal RAM.
# Together 32 KB more internal RAM free, and Wi-Fi was no slower.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=8
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
